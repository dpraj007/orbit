# ============================================
# KAFKA CONFIGURATION
# ============================================
# Kafka cluster connection details (provided by Series team)
KAFKA_BOOTSTRAP_SERVERS=pkc-619z3.us-east1.gcp.confluent.cloud:9092

# Your team's Kafka topic (format: team.team.<YOUR_TEAM_ID>)
KAFKA_TOPIC=team.team.b75820cf492645e28fbe38fc7857e8d5

# Consumer group ID (format: team-cg-<YOUR_TEAM_ID>)
KAFKA_CONSUMER_GROUP=team-cg-b75820cf492645e28fbe38fc7857e8d5

# Client ID for this consumer (format: team-client-<YOUR_TEAM_ID>)
KAFKA_CLIENT_ID=team-client-b75820cf492645e28fbe38fc7857e8d5

# Kafka SASL credentials (provided by Series team)
KAFKA_SASL_USERNAME=QRHNR6BCKVHD4M3U
KAFKA_SASL_PASSWORD=YOUR_KAFKA_PASSWORD_HERE

# Kafka security settings (usually don't need to change these)
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN

# ============================================
# SERIES API CONFIGURATION
# ============================================
# Series iMessage API base URL (provided by Series team)
SERIES_BASE_URL=https://YOUR_SERIES_HOST_HERE

# Your Series API key (provided by Series team)
SERIES_API_KEY=YOUR_SERIES_API_KEY_HERE

# Phone number to send messages from (provided by Series team)
SERIES_SENDER_NUMBER=+16463769330

# ============================================
# LLM CONFIGURATION
# ============================================
# OpenRouter API key (get from https://openrouter.ai/)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# LLM model to use (recommended: x-ai/grok-4.1-fast or anthropic/claude-3.5-sonnet)
# Options:
#   - x-ai/grok-4.1-fast (fast, good for real-time)
#   - anthropic/claude-3.5-sonnet (more thoughtful, higher quality)
#   - openai/gpt-4-turbo (balanced)
OPENROUTER_MODEL=x-ai/grok-4.1-fast

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Path to SQLite database file
DATABASE_PATH=./orbit.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# HTTP request timeout in seconds
REQUEST_TIMEOUT_SEC=10

# Maximum number of retries for failed requests
MAX_RETRIES=3

# Threshold for considering conversations stale (in minutes)
STALE_THRESHOLD_MIN=45
